# Copy to .env.development.local for `npm run dev` (local SPA redirect URI)
# and to .env.production.local for `npm run build` (HTTPS SPA redirect URI).
# Public browser IDs only. Never add a client secret, password or token.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_REDIRECT_URI=http://localhost:5173/oauth2callback
VITE_PORTAL_URL=http://localhost:5174/
