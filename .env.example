# ==============================================================================
# ITOM Telemetry & Operations Platform - Environment Configuration Template
# ==============================================================================
# Instructions: Copy this template to `.env` and populate with environment-specific credentials.
# NEVER commit the `.env` file to source control.

# --- Microsoft Intune / Microsoft Graph API Configuration ---
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here
AZURE_SECRET_ID=your-secret-id-here

# --- SolarWinds Orion SWIS API v3 Configuration ---
SOLARWINDS_HOST=your-solarwinds-host.example.com
SOLARWINDS_PORT=17774
SOLARWINDS_USERNAME=your-swis-username
SOLARWINDS_PASSWORD=your-swis-password-here

# --- Web Server & Supervisor Runtime Configuration ---
HOST=0.0.0.0
PORT=8080
SYNC_INTERVAL_SECONDS=600

# --- On-Prem VM / Remote Deployment Configuration ---
LOCAL_SERVER_IP=192.168.1.100
LOCAL_SERVER_USER=itom-deployer
LOCAL_SERVER_PORT=8080
