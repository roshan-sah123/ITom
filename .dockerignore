# Keep the API image build context small and free of local/private data.
.git/
.github/
.agents/
.env
.env.*
.vm-credential.xml

# Local development and generated data
.venv/
venv/
node_modules/
__pycache__/
.pytest_cache/
.coverage
htmlcov/
*.py[cod]
*$py.class
*.log

# Tests and documentation are not required by the runtime image
tests/
docs/
HANDOVER/
scratch/

# Local databases, snapshots, and exports (Compose bind mounts remain unaffected)
backups/
logs/
exports/
data/*.db
data/*.sqlite
data/*.db-journal
data/*.db-*
data/*.json

# UI previews are design artifacts, not deployed assets
frontend/demo_previews/
